# Placeholders only. Copy to a server-side env file and replace every value.
# Do not commit real store credentials, private keys, or this file with secrets.

PORT=8080
DATABASE_PATH=./data/billing.sqlite

ANDROID_PACKAGE_NAME=com.registry.app
IOS_BUNDLE_ID=com.example.theRegistry
LOCAL_PRO_PRODUCT_ID=local_pro
REVALIDATE_AFTER_HOURS=24

# Ed25519 private JWK. Generate on the server with npm run generate-grant-key.
BILLING_GRANT_PRIVATE_JWK=replace-with-ed25519-private-jwk
# Raw 32-byte public key, standard base64. Not a secret. The app needs it only in a build allowed to verify grants.
BILLING_GRANT_PUBLIC_KEY_B64=replace-with-ed25519-public-key-base64

# 32-byte key, standard base64, for encrypting purchase tokens at rest.
BILLING_TOKEN_KEY_B64=replace-with-32-byte-base64-key
# Pepper for restore-code hashes. Any long random string.
RECOVERY_CODE_PEPPER=replace-with-random-pepper

# Google Play Android Developer API service account JSON, one line or a file path.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-with-service-account-json
GOOGLE_PUBSUB_AUDIENCE=replace-with-pubsub-push-audience
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=replace-with-pubsub-push-service-account-email

# App Store Server API key and Apple root certificates.
APPLE_ISSUER_ID=replace-with-issuer-id
APPLE_KEY_ID=replace-with-key-id
APPLE_PRIVATE_KEY=replace-with-p8-pem
APPLE_ROOT_CA_DIR=replace-with-apple-root-ca-directory
APPLE_APP_APPLE_ID=0

RATE_LIMIT_VERIFY_PER_MINUTE=30
RATE_LIMIT_RESTORE_PER_MINUTE=10
BODY_LIMIT_VERIFY_BYTES=16384
BODY_LIMIT_NOTIFICATION_BYTES=262144
